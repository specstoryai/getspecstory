id: 1791904486853-0
event: tool_call
data: {"callId":"toolu_01Ptw8Cxou3GGjBgx556DDXX","name":"get_mcp_tools","status":"completed","args":{"server":"cursor-subscriptions","toolName":"subscribe_timer","toolCallId":"toolu_01Ptw8Cxou3GGjBgx556DDXX"},"result":{"success":{"content":"{\n  \"tool\": \"subscribe_timer\",\n  \"description\": \"Subscribe a timer that enqueues the given prompt as a follow-up that runs when this Cloud Agent is otherwise free. Provide exactly one of `cron` (a cron expression) or `delaySeconds` (a fixed interval, in seconds). By default the timer recurs on each fire while active. Set `once: true` (with `delaySeconds`) for a one-off timer that fires a single time after the delay and then removes itself — e.g. \\\"remind me in 1 hour\\\". Dedupes by name. List and remove timers via list_subscriptions / unsubscribe. After subscribing, state what you are waiting for and end your turn; the event arrives as a follow-up notification in this conversation.\",\n  \"inputSchema\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"name\": {\n        \"type\": \"string\"\n      },\n      \"prompt\": {\n        \"type\": \"string\"\n      },\n      \"cron\": {\n        \"type\": \"string\",\n        \"description\": \"Cron expression for recurrence. Provide this OR delaySeconds, not both.\"\n      },\n      \"delaySeconds\": {\n        \"type\": \"number\",\n        \"description\": \"Interval, in seconds. For a recurring timer this is the fixed interval between fires; with `once: true` it is the one-off delay before the single fire. Provide this OR cron, not both.\"\n      },\n      \"once\": {\n        \"type\": \"boolean\",\n        \"description\": \"When true, fire exactly once after `delaySeconds` and then remove the timer. Requires `delaySeconds` (not valid with `cron`). Defaults to false (recurring).\"\n      }\n    },\n    \"required\": [\n      \"name\",\n      \"prompt\"\n    ]\n  }\n}"}}}

